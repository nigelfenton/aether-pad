// arduino_secrets.h.example — copy to arduino_secrets.h (same folder) and edit.
// arduino_secrets.h is in .gitignore, so your WiFi password never gets committed.
#pragma once

#define SECRET_SSID  "your-2.4GHz-ssid"
#define SECRET_PASS  "your-wifi-password"

// Where to try if the UDP discovery probe goes unanswered: the LAN address of
// the machine running AetherSDR, as comma-separated octets, and its TCI port
// (AetherSDR's default is 50001). Override at runtime with `ip <addr>` over
// serial.
#define SECRET_FALLBACK_HOST  192, 168, 1, 100
#define SECRET_FALLBACK_PORT  50001
